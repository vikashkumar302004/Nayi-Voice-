# Add real values only in .env (never commit that file)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
GROQ_API_KEY=
# Optional comma-separated pool. The server rotates keys and fails over on rate limits/errors.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DATABASE_FILE=./data/nayi-voice.db
REDIS_URL=
APP_SECRET=
API_PORT=8787
PUBLIC_BASE_URL=https://your-public-domain.example
